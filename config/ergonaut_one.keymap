#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick-tap-ms = <200>; };

&mt { quick-tap-ms = <200>; };

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <260>;
            quick-tap-ms = <125>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 18 30 31 19 7 8 20 32 33 21 9 10 22 34 35 23 11 39 40 41>;
            require-prior-idle-ms = <110>;
        };

        hrmr: hrmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <260>;
            quick-tap-ms = <125>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            require-prior-idle-ms = <110>;
        };

        lml: lml {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_MOD_LEFT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <260>;
            quick-tap-ms = <125>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 41 40 39>;
            require-prior-idle-ms = <110>;
        };

        lmr: lmr {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_MOD_RIGHT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <260>;
            quick-tap-ms = <125>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            require-prior-idle-ms = <110>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "MAIN";
            bindings = <
&kp RIGHT_BRACKET  &kp Q         &kp W         &kp E          &kp R           &kp T    &kp Y      &kp U           &kp I          &kp O         &kp P            &kp LBKT
&kp GRAVE          &hrml LGUI A  &hrml LALT S  &hrml LCTRL D  &hrml LSHIFT F  &kp G    &kp H      &hrmr RSHIFT J  &hrmr RCTRL K  &hrmr RALT L  &hrmr RGUI SEMI  &kp SQT
&kp MINUS          &lml 4 Z      &lml 3 X      &lml 2 C       &lml 1 V        &kp B    &kp N      &lmr 1 M        &lmr 2 COMMA   &kp DOT       &lmr 4 SLASH     &kp F18
                                               &kp EQUAL      &kp TAB         &kp ESC  &kp SPACE  &kp ENTER       &kp BACKSPACE
            >;
        };

        lower_layer {
            display-name = "SYM";
            bindings = <
&kp F1   &kp F2    &kp F3  &kp F4      &kp F5    &kp F6     &kp F7     &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&kp F13  &kp EXCL  &kp AT  &kp HASH    &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp PIPE
&kp F14  &kp N1    &kp N2  &kp N3      &kp N4    &kp N5     &kp N6     &kp N7    &kp N8    &kp N9    &kp N0    &kp BACKSLASH
                           &kp DELETE  &trans    &trans     &trans     &trans    &trans
            >;
        };

        raise_layer {
            display-name = "NUM";
            bindings = <
&mt LGUI KP_NUM  &kp KP_SLASH     &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &kp C_VOL_UP  &kp HOME  &kp UP_ARROW  &kp PG_UP      &kp CAPS              &kp F17
&kp F15          &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &kp C_MUTE    &kp LEFT  &kp DOWN      &kp RIGHT      &kp K_APPLICATION     &kp F19
&kp F16          &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT    &kp C_VOL_DN  &kp END   &kp PSCRN     &kp PAGE_DOWN  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC
                                             &trans     &trans     &trans        &trans        &trans    &trans
            >;
        };

        mouse_layer {
            bindings = <
&none  &none  &none  &none           &none           &none            &msc SCRL_UP    &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none           &none
&none  &none  &none  &msc SCRL_UP    &msc SCRL_LEFT  &msc SCRL_RIGHT  &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_LEFT  &msc SCRL_RIGHT
&none  &none  &none  &msc SCRL_DOWN  &mkp LCLK       &none            &none           &mkp MB4        &mkp MB3        &mkp MB5         &none           &none
                     &none           &none           &none            &none           &none           &none
            >;
        };

        adjust_layer {
            display-name = "ADJ";
            bindings = <
&bootloader  &studio_unlock  &none         &none         &none         &none         &none         &none         &none         &none         &studio_unlock  &bootloader
&bt BT_CLR   &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0    &bt BT_CLR
&sys_reset   &none           &none         &none         &none         &none         &none         &none         &none         &none         &none           &sys_reset
                                           &trans        &none         &trans        &none         &trans        &trans
            >;
        };
    };
};
